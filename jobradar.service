[Unit]
Description=JobRadar chain: fetch S3 postings -> scoring funnel -> deliver to Sheets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Deps live in a project venv (system python3 has none), so point the chain at it.
Environment=JOBRADAR_PYTHON=%h/job-radar/.venv/bin/python
# Absolute path required by systemd. Replace with the repo path on the M720q,
# e.g. /home/aarush/job-radar/run_chain.sh
ExecStart=%h/job-radar/run_chain.sh

# stdout/stderr are captured by the journal automatically:
#   journalctl --user -u jobradar.service
