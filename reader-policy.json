{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jobradar-raw-postings-aarushsingh",
      "Condition": {
        "StringLike": {
          "s3:prefix": "raw-postings/*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jobradar-raw-postings-aarushsingh/raw-postings/*"
    }
  ]
}
